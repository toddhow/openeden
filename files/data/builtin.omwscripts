# UI framework
MENU,PLAYER: scripts/omw/mwui/init.lua

# Settings framework
MENU: scripts/omw/settings/menu.lua
PLAYER: scripts/omw/settings/player.lua
GLOBAL: scripts/omw/settings/global.lua

# Mechanics
GLOBAL: scripts/omw/activationhandlers.lua
GLOBAL: scripts/omw/usehandlers.lua
GLOBAL: scripts/omw/worldeventhandlers.lua
GLOBAL: scripts/omw/crimes.lua
CREATURE, NPC, PLAYER: scripts/omw/mechanics/animationcontroller.lua
PLAYER: scripts/omw/skillhandlers.lua
PLAYER: scripts/omw/mechanics/playercontroller.lua
MENU: scripts/omw/camera/settings.lua
MENU: scripts/omw/input/settings.lua
PLAYER: scripts/omw/input/playercontrols.lua
PLAYER: scripts/omw/camera/camera.lua
PLAYER: scripts/omw/input/actionbindings.lua
PLAYER: scripts/omw/input/smoothmovement.lua
PLAYER: scripts/omw/input/gamepadcontrols.lua
NPC,CREATURE: scripts/omw/ai.lua
GLOBAL: scripts/omw/mechanics/globalcontroller.lua
CREATURE, NPC, PLAYER: scripts/omw/mechanics/actorcontroller.lua
NPC,CREATURE,PLAYER: scripts/omw/combat/interface.lua

# User interface
PLAYER: scripts/omw/ui.lua

# Lua console
MENU: scripts/omw/console/menu.lua
PLAYER: scripts/omw/console/player.lua
GLOBAL: scripts/omw/console/global.lua
CUSTOM: scripts/omw/console/local.lua

# Music system
NPC,CREATURE: scripts/omw/music/actor.lua

# Skyrim SE combat HUD (task 0180); started only when the game pack declares the package
PLAYER REQUIRES=core.skyrimse.combat>=1.0: scripts/openeden/skyrim_combat_hud.lua
# Task 0227: the sneak eye and the sneak attack message (the pack setting [extension.skyrimse] sneak)
PLAYER REQUIRES=core.skyrimse.sneak>=1.0: scripts/openeden/skyrim_sneak_hud.lua
# Task 0244: the restyled combat HUD (the pack setting [extension.skyrimse] hud style)
PLAYER REQUIRES=core.skyrimse.hudstyle>=1.0: scripts/openeden/skyrim_hud_style.lua
# Skyrim SE inventory and container windows (task 0182); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.inventory>=1.1: scripts/openeden/skyrimse/inventory_global.lua
PLAYER REQUIRES=core.skyrimse.inventory>=1.1: scripts/openeden/skyrimse/inventory_player.lua
GLOBAL REQUIRES=core.skyrimse.barter>=1.0: scripts/openeden/skyrimse/barter_global.lua
PLAYER REQUIRES=core.skyrimse.barter>=1.0: scripts/openeden/skyrimse/barter_player.lua
GLOBAL REQUIRES=core.skyrimse.services>=1.0: scripts/openeden/skyrimse/services_global.lua
PLAYER REQUIRES=core.skyrimse.services>=1.0: scripts/openeden/skyrimse/services_player.lua
GLOBAL REQUIRES=core.skyrimse.crafting>=1.0: scripts/openeden/skyrimse/crafting_global.lua
PLAYER REQUIRES=core.skyrimse.crafting>=1.0: scripts/openeden/skyrimse/crafting_player.lua
# Skyrim SE quest journal (task 0185); started only when the session's game pack has the namespace
PLAYER REQUIRES=core.skyrimse.journal>=1.0: scripts/openeden/skyrimse/journal_player.lua
# Skyrim SE Papyrus notifications on the HUD (task 0198); started only when the pack's Papyrus host declares the namespace
PLAYER REQUIRES=core.skyrimse.papyrus>=1.0: scripts/openeden/skyrimse/papyrus_player.lua
# Skyrim SE diseases: the contracted and cured messages and a status line (task 0240); started only when the pack setting `diseases` is on
PLAYER REQUIRES=core.skyrimse.diseases>=1.0: scripts/openeden/skyrimse/diseases_player.lua
# Skyrim SE skills and perks (task 0200); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.progression>=1.0: scripts/openeden/skyrimse/skills_global.lua
PLAYER REQUIRES=core.skyrimse.progression>=1.0: scripts/openeden/skyrimse/skills_player.lua
# Skyrim SE compass and world map (task 0201); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.map>=1.0: scripts/openeden/skyrimse/map_global.lua
# Task 0218: fast travel from the world map (the pack setting [extension.skyrimse] fast travel, which needs map)
GLOBAL REQUIRES=core.skyrimse.travel>=1.0: scripts/openeden/skyrimse/travel_global.lua
PLAYER REQUIRES=core.skyrimse.map>=1.0: scripts/openeden/skyrimse/map_player.lua
# Skyrim SE crime: the guard's offer and the jail (task 0204); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.crime>=1.0: scripts/openeden/skyrimse/crime_global.lua
PLAYER REQUIRES=core.skyrimse.crime>=1.0: scripts/openeden/skyrimse/crime_player.lua
# Skyrim SE message boxes of Papyrus scripts, the standing stones' "choose this sign?" among them (task 0237)
GLOBAL REQUIRES=core.skyrimse.messages>=1.0: scripts/openeden/skyrimse/messages_global.lua
PLAYER REQUIRES=core.skyrimse.messages>=1.0: scripts/openeden/skyrimse/messages_player.lua
# Skyrim SE lock picking and books (task 0203); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.lockbooks>=1.0: scripts/openeden/skyrimse/lockpick_global.lua
PLAYER REQUIRES=core.skyrimse.lockbooks>=1.0: scripts/openeden/skyrimse/lockpick_player.lua
GLOBAL REQUIRES=core.skyrimse.lockbooks>=1.0: scripts/openeden/skyrimse/books_global.lua
PLAYER REQUIRES=core.skyrimse.lockbooks>=1.0: scripts/openeden/skyrimse/books_player.lua
# Task 0234: books lying in the world are read in place
GLOBAL REQUIRES=core.skyrimse.worldbooks>=1.0: scripts/openeden/skyrimse/worldbooks_global.lua
# Skyrim SE item pickup and pickpocketing (task 0208): the namespace is declared with the inventory.
GLOBAL REQUIRES=core.skyrimse.pickup>=1.0: scripts/openeden/skyrimse/pickup_global.lua
PLAYER REQUIRES=core.skyrimse.pickup>=1.0: scripts/openeden/skyrimse/pickup_player.lua
# Skyrim SE harvesting flora (task 0221); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.harvest>=1.0: scripts/openeden/skyrimse/harvest_global.lua
PLAYER REQUIRES=core.skyrimse.harvest>=1.0: scripts/openeden/skyrimse/harvest_player.lua
# Skyrim SE mining ore veins and chopping wood (task 0224); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.mining>=1.0: scripts/openeden/skyrimse/mining_global.lua
PLAYER REQUIRES=core.skyrimse.mining>=1.0: scripts/openeden/skyrimse/mining_player.lua
# Skyrim SE: the player's level stat follows the progression so that saves show it (task 0215)
PLAYER REQUIRES=core.skyrimse.progression>=1.0: scripts/openeden/skyrimse/presentation_player.lua
# Skyrim SE waiting and sleeping (task 0210); started only when the session's game pack has the namespace
GLOBAL REQUIRES=core.skyrimse.rest>=1.0: scripts/openeden/skyrimse/rest_global.lua
PLAYER REQUIRES=core.skyrimse.rest>=1.0: scripts/openeden/skyrimse/rest_player.lua
# Skyrim SE main menu, pause menu and loading screen tips (task 0207); started only when the session's game pack has the
# namespace (the pack setting [extension.skyrimse] menus) and [GUI] rmlui is on (the script needs openeden.ui)
MENU REQUIRES=core.skyrimse.menus>=1.0: scripts/openeden/skyrimse/menus_menu.lua
# Task 0225: the character creation (the pack setting [extension.skyrimse] character creation)
GLOBAL REQUIRES=core.skyrimse.character>=1.0: scripts/openeden/skyrimse/character_global.lua
PLAYER REQUIRES=core.skyrimse.character>=1.0: scripts/openeden/skyrimse/character_player.lua
# Skyrim SE shout cooldown indicator (task 0205)
PLAYER REQUIRES=core.skyrimse.shouts>=1.0: scripts/openeden/skyrimse/shouts_player.lua
